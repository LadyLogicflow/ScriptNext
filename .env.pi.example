# Etappe 4c (Raspberry Pi, ARM64) -- fuer docker-compose.pi.yml.
# Kopieren nach .env (daneben, im Repo-Root) und ausfuellen.

# Datenbank-Passwort fuer den db-Container (frei waehlbar, einmalig).
SCRIPTNEXT_DB_PASSWORT=

# JWT-Secret -- erzeugen mit: python3 -c "import secrets; print(secrets.token_hex(32))"
SCRIPTNEXT_JWT_SECRET=

# Bootstrap-Admin (Klartext hier, wird beim Anlegen gehasht -- siehe
# app._sicherstelle_dev_admin()). Danach ueber die Admin-UI weitere
# Nutzer anlegen, dieses Konto ist nur fuer den Erst-Login gedacht.
SCRIPTNEXT_ADMIN_EMAIL=
SCRIPTNEXT_ADMIN_PASSWORT=

# Woher darf das Frontend Requests an das Backend schicken (Browser-
# Origin, NICHT localhost, wenn der Pi im LAN unter eigenem Hostnamen/
# IP erreichbar ist -- z.B. http://scriptnext.local:3000).
SCRIPTNEXT_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Woher das Frontend das Backend erreicht (wird beim Frontend-Build
# fest einkompiliert, siehe Hinweis in docker-compose.pi.yml) --
# dieselbe Pi-Adresse wie oben, nur mit dem Backend-Port 8100.
SCRIPTNEXT_FRONTEND_API_BASE=http://localhost:8100

# Optional, je nach genutzten Features:
SCRIPTNEXT_OPENAI_API_KEY=
SCRIPTNEXT_ANTHROPIC_API_KEY=
SCRIPTNEXT_SHAREPOINT_CLIENT_ID=
SCRIPTNEXT_SHAREPOINT_TOKEN_KEY=
