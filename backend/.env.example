SCRIPTNEXT_DATABASE_URL=postgresql+asyncpg://scriptnext:scriptnext@localhost:5432/scriptnext
SCRIPTNEXT_DATABASE_URL_SYNC=postgresql://scriptnext:scriptnext@localhost:5432/scriptnext

# JWT — REPLACE IN PROD mit: python3 -c "import secrets; print(secrets.token_hex(32))"
SCRIPTNEXT_JWT_SECRET=dev-secret-REPLACE-IN-PROD

# Admin (DEV-ONLY — vor Prod-Deploy ersetzen!)
SCRIPTNEXT_ADMIN_BENUTZERNAME=admin
# Hash generieren: python3 -c "from passlib.context import CryptContext; print(CryptContext(['bcrypt']).hash('dein-passwort'))"
SCRIPTNEXT_ADMIN_PASSWORT_HASH=

# Embeddings (optional — ohne Key wird Embedding-Schritt übersprungen)
SCRIPTNEXT_OPENAI_API_KEY=
